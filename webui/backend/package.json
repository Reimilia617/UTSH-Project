{
  "name": "utsh-webui-backend",
  "version": "0.1.0",
  "private": true,
  "description": "UTSH WebUI backend (Fastify). Connects to the Rust core over a Unix Domain Socket using JSON-RPC 2.0.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/routes/index.js",
    "smoke": "node test/smoke.js"
  },
  "dependencies": {
    "@fastify/websocket": "^8.3.1",
    "fastify": "^4.28.1",
    "smol-toml": "^1.3.1"
  }
}
